{
  "name": "hydrogenmusic",
  "private": true,
  "version": "0.6.3",
  "description": "A modern music player built with Electron and Vue.js",
  "main": "background.js",
  "author": {
    "name": "ldx123000",
    "email": "ldx123000@gmail.com"
  },
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -CheckOnly",
    "android:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Clean",
    "mobile": "node server/mobile-server.cjs",
    "mobile:serve": "vite build && node server/mobile-server.cjs",
    "mobile:test": "node scripts/mobile-test/cdp.cjs",
    "api": "node server/api-server.cjs",
    "postinstall": "node scripts/patch-ncm-api.cjs",
    "start": "nodemon --exec electron . --watch ./ --ext js,vue,html,css,json",
    "_dist": "vite build && node scripts/build.js -p always",
    "dist": "vite build && node scripts/build.js -p never",
    "mpv:download": "node scripts/mpv-audio-only/download-artifacts.cjs",
    "mpv:download:all": "node scripts/mpv-audio-only/download-artifacts.cjs --platform all"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capawesome/capacitor-nodejs": "^0.1.1",
    "@neteasecloudmusicapienhanced/api": "^4.35.1",
    "axios": "^1.12.2",
    "dbus-next": "^0.10.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.2.0",
    "fs-extra": "^11.3.2",
    "iconv-lite": "^0.6.3",
    "metaflac-js": "^1.0.5",
    "mime-types": "^3.0.2",
    "mpris-service": "^2.1.2",
    "music-metadata": "^11.9.0",
    "nanoid": "^5.1.6",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^38.3.0",
    "electron-builder": "^26.1.0",
    "howler": "^2.2.4",
    "js-cookie": "^3.0.5",
    "nodemon": "^3.1.10",
    "opencc-js": "^1.0.5",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "plyr": "^3.8.3",
    "qrcode": "^1.5.4",
    "rollup": "npm:@rollup/wasm-node@^4.52.5",
    "sass": "^1.93.2",
    "terser": "^5.44.0",
    "vite": "^7.1.10",
    "vue": "^3.5.22",
    "vue-router": "^4.6.0",
    "vue-slider-component": "^4.1.0-beta.6",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  }
}
